# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=

# 공연장 주소 → 좌표 변환 스크립트(scripts/geocode-venues.mjs)용 카카오 REST API 키 (서버·스크립트 전용, VITE_ 금지)
KAKAO_REST_KEY=

# 카카오 지도 JavaScript 키 (브라우저에 노출되는 키라 VITE_ 가 붙음 — 카카오 개발자 콘솔에서 JavaScript SDK 도메인 등록 필수)
# 없으면 앱이 자동으로 OpenStreetMap(Leaflet) 지도로 대신함
VITE_KAKAO_JS_KEY=
